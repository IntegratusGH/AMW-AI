# ==========================================================================
#  AMW-AI Web Application - Environment Configuration (template)
#  Copy this file to ".env" and fill in the real values.
# ==========================================================================

# --- Flask ----------------------------------------------------------------
# Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret
FLASK_ENV=production

# --- Web server (Waitress) ------------------------------------------------
# 0.0.0.0 makes the app reachable from other computers on the network.
HOST=0.0.0.0
PORT=8080

# --- Microsoft SQL Server -------------------------------------------------
DB_HOST=localhost
# Leave DB_PORT empty for the default instance (1433).
DB_PORT=
DB_NAME=AMW-AI
DB_USER=sa
DB_PASSWORD=your-sql-password

# ODBC driver name exactly as it appears in "ODBC Data Sources".
#   Recommended (install separately): ODBC Driver 18 for SQL Server
#   Currently installed on this server: SQL Server
DB_DRIVER=SQL Server

# Encryption options (mainly relevant for "ODBC Driver 17/18 for SQL Server").
# For the legacy "SQL Server" driver these are ignored.
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# --- Login provisioning ---------------------------------------------------
# On setup, ensure the SQL login named by DB_USER exists with DB_PASSWORD and
# can create its database (granted 'dbcreator').  This runs via an
# administrative connection because the app login cannot create itself.
# Set to no if the login is managed externally.  Skipped automatically when
# DB_USER is 'sa' or a Windows account (contains a backslash).
DB_PROVISION_LOGIN=yes
# Administrative identity used only to provision the login above.
# Default: a Windows trusted connection (the installer runs elevated and
# BUILTIN\Administrators is a SQL sysadmin), so no admin password is stored.
DB_ADMIN_TRUSTED=yes
# When DB_ADMIN_TRUSTED=no, use these instead (DB_ADMIN_PASSWORD falls back to
# DB_PASSWORD if unset):
#DB_ADMIN_USER=sa
#DB_ADMIN_PASSWORD=your-sa-password

# --- Active Directory / LDAP sign-in --------------------------------------
# When enabled, administrators can add AD accounts (looked up via a read-only
# service account) and those users sign in with their AD credentials (verified
# by an LDAP bind).  Local accounts keep working regardless.
AD_ENABLED=no
# Domain controller host/FQDN.  LDAPS (port 636) is strongly recommended.
AD_SERVER=dc01.corp.example.com
AD_PORT=636
AD_USE_SSL=yes
# NetBIOS domain (e.g. AMWLTD) and/or UPN suffix (e.g. corp.example.com).
# If AD_UPN_SUFFIX is set, users bind as <username>@<suffix>; otherwise as
# <AD_DOMAIN>\<username>.
AD_DOMAIN=AMWLTD
AD_UPN_SUFFIX=corp.example.com
# Search base for directory lookups (add-AD-user flow).
AD_BASE_DN=DC=corp,DC=example,DC=com
# Read-only service account used ONLY for lookups (never to sign users in).
#AD_BIND_USER=svc-amwai@corp.example.com
#AD_BIND_PASSWORD=<service-account password>
# Advanced: LDAP filter for locating a user by their typed name.
#AD_USER_SEARCH_FILTER=(sAMAccountName={username})

# --- OCR scan enhancement (Registration Updater) --------------------------
# Accuracy enhancements for poor-quality scans (grey/low-contrast background,
# trilingual Sinhala/Tamil/English layout): full-page flat-fielding before text
# detection, an extra flat-field voting variant, non-Latin script-noise
# filtering, and a same-row value fallback.  All are gated by this one switch
# and only engage on scans that need them, so clean scans are unaffected.
# ROLLBACK: set OCR_ENHANCE=no and restart the service to revert exactly to the
# prior behaviour (no rebuild required).
OCR_ENHANCE=yes
# Pages whose paper background (85th-percentile brightness, 0-255) is at or
# above this are treated as already-clean and left un-normalised.
OCR_BG_WHITE_MIN=215

# --- Default administrator (created by scripts/init_db.py) -----------------
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@12345
